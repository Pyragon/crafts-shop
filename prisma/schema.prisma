// Catalogue schema.
//
// Shaped with the Phase 7 admin in mind, so managing products there is UI over
// fields that already exist rather than another migration: every table carries
// timestamps, products have an explicit draft/published/archived lifecycle,
// stock is a first-class column, and images carry their own ordering and alt
// text so they can be reordered and captioned without touching the product.
//
// Money is stored as integer cents everywhere. Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Draft products are invisible to the storefront but editable in the admin.
/// Archived ones are hidden without being deleted, so past orders keep
/// referring to something real.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  /// Manual ordering for the shop nav; admin drag-to-reorder writes this.
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([position])
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Short line used on cards and in listings.
  blurb       String
  /// Long form copy for the product page.
  description String?

  priceCents     Int
  /// Optional "was" price. When set and higher, the product reads as on sale.
  compareAtCents Int?

  /// Optional human-facing stock code for the maker's own records. Variants
  /// carry their own SKUs; this is the parent code.
  sku String? @unique

  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  publishedAt DateTime?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images ProductImage[]

  options  ProductOption[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
}

/// One axis of variation for a product — "Colour", "Size", "Logo".
/// `position` maps to ProductVariant.option1/2/3.
model ProductOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, position])
  @@index([productId])
}

/// A buyable combination. Every product has at least one, even when it has no
/// options at all — that uniformity is the point: stock, price and SKU always
/// live in exactly one place, and the cart always points at a variant, so
/// there is never a second code path for "products without variants".
///
/// Option values are stored denormalised in option1/2/3 rather than through a
/// join table. It is how Shopify stores them, it keeps every listing query a
/// single cheap read, and three axes is far more than this shop will need.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Line up with ProductOption.position 0, 1 and 2.
  option1 String?
  option2 String?
  option3 String?

  sku        String? @unique
  /// Null means "same as the product's base price", so a shop with uniform
  /// pricing never has to restate it per variant.
  priceCents Int?
  stock      Int     @default(0)
  position   Int     @default(0)

  /// Optional: which photo to show when this variant is selected.
  imageId String?
  image   ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Storage location is deliberately just a string — local path now, object
  /// storage later, without a schema change.
  url      String
  /// Required: an image with no alt text is an accessibility and SEO defect,
  /// so the admin form will have to collect it.
  alt      String
  width    Int?
  height   Int?
  /// 0 is the primary image shown on cards.
  position Int    @default(0)

  createdAt       DateTime         @default(now())
  productVariants ProductVariant[]

  @@index([productId, position])
}

/// A cart is identified by an opaque token in an httpOnly cookie. `userId` is
/// unused until accounts exist (Phase 3) but is modelled now so signing in can
/// merge an anonymous cart into the user's own without a migration.
model Cart {
  id     String  @id @default(cuid())
  /// Opaque value stored in the cart cookie.
  token  String  @unique
  userId String?

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per variant per cart; adding again bumps the quantity.
  @@unique([cartId, variantId])
  @@index([variantId])
}
