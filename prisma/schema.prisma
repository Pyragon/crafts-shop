// Catalogue schema.
//
// Shaped with the Phase 7 admin in mind, so managing products there is UI over
// fields that already exist rather than another migration: every table carries
// timestamps, products have an explicit draft/published/archived lifecycle,
// stock is a first-class column, and images carry their own ordering and alt
// text so they can be reordered and captioned without touching the product.
//
// Money is stored as integer cents everywhere. Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Draft products are invisible to the storefront but editable in the admin.
/// Archived ones are hidden without being deleted, so past orders keep
/// referring to something real.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  /// Manual ordering for the shop nav; admin drag-to-reorder writes this.
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([position])
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  /// Short line used on cards and in listings.
  blurb       String
  /// Long form copy for the product page.
  description String?

  priceCents  Int
  /// Optional "was" price. When set and higher, the product reads as on sale.
  compareAtCents Int?

  /// Optional human-facing stock code for the maker's own records.
  sku         String?       @unique
  stock       Int           @default(0)

  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  publishedAt DateTime?

  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images      ProductImage[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Storage location is deliberately just a string — local path now, object
  /// storage later, without a schema change.
  url       String
  /// Required: an image with no alt text is an accessibility and SEO defect,
  /// so the admin form will have to collect it.
  alt       String
  width     Int?
  height    Int?
  /// 0 is the primary image shown on cards.
  position  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([productId, position])
}
