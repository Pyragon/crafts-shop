// Catalogue schema.
//
// Shaped with the Phase 7 admin in mind, so managing products there is UI over
// fields that already exist rather than another migration: every table carries
// timestamps, products have an explicit draft/published/archived lifecycle,
// stock is a first-class column, and images carry their own ordering and alt
// text so they can be reordered and captioned without touching the product.
//
// Money is stored as integer cents everywhere. Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Draft products are invisible to the storefront but editable in the admin.
/// Archived ones are hidden without being deleted, so past orders keep
/// referring to something real.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  /// Manual ordering for the shop nav; admin drag-to-reorder writes this.
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([position])
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Short line used on cards and in listings.
  blurb       String
  /// Long form copy for the product page.
  description String?

  priceCents     Int
  /// Optional "was" price. When set and higher, the product reads as on sale.
  compareAtCents Int?

  /// Optional human-facing stock code for the maker's own records. Variants
  /// carry their own SKUs; this is the parent code.
  sku String? @unique

  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  publishedAt DateTime?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images ProductImage[]

  options               ProductOption[]
  variants              ProductVariant[]
  personalisationFields PersonalisationField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
}

/// One axis of variation for a product — "Colour", "Size", "Logo".
/// `position` maps to ProductVariant.option1/2/3.
model ProductOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, position])
  @@index([productId])
}

/// A buyable combination. Every product has at least one, even when it has no
/// options at all — that uniformity is the point: stock, price and SKU always
/// live in exactly one place, and the cart always points at a variant, so
/// there is never a second code path for "products without variants".
///
/// Option values are stored denormalised in option1/2/3 rather than through a
/// join table. It is how Shopify stores them, it keeps every listing query a
/// single cheap read, and three axes is far more than this shop will need.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Line up with ProductOption.position 0, 1 and 2.
  option1 String?
  option2 String?
  option3 String?

  sku        String? @unique
  /// Null means "same as the product's base price", so a shop with uniform
  /// pricing never has to restate it per variant.
  priceCents Int?
  stock      Int     @default(0)
  position   Int     @default(0)

  /// Whether choosing this variant asks the customer to fill in the product's
  /// personalisation fields. Lets "Lettered" require a monogram while
  /// "Not lettered" asks for nothing.
  personalised Boolean @default(false)

  /// Optional: which photo to show when this variant is selected.
  imageId String?
  image   ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
}

/// A free-text field the customer fills in — a monogram, a name, a date.
///
/// Distinct from a variant: a variant is a fixed choice the shop decides in
/// advance, whereas this is content only the customer can supply. Pricing still
/// belongs to the variant (a "Lettered" variant simply costs more), so these
/// fields carry no money.
model PersonalisationField {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Shown above the input, e.g. "Monogram".
  label     String
  /// Optional hint, e.g. "Up to three letters".
  helpText  String?
  maxLength Int     @default(40)
  required  Boolean @default(true)
  position  Int     @default(0)

  values CartItemPersonalisation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, position])
}

/// What the customer actually typed, per cart line.
model CartItemPersonalisation {
  id         String   @id @default(cuid())
  cartItemId String
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  fieldId String
  field   PersonalisationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  value String

  @@unique([cartItemId, fieldId])
  @@index([fieldId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Storage location is deliberately just a string — local path now, object
  /// storage later, without a schema change.
  url      String
  /// Required: an image with no alt text is an accessibility and SEO defect,
  /// so the admin form will have to collect it.
  alt      String
  width    Int?
  height   Int?
  /// 0 is the primary image shown on cards.
  position Int    @default(0)

  createdAt       DateTime         @default(now())
  productVariants ProductVariant[]

  @@index([productId, position])
}

/// A cart is identified by an opaque token in an httpOnly cookie. `userId` is
/// unused until accounts exist (Phase 3) but is modelled now so signing in can
/// merge an anonymous cart into the user's own without a migration.
model Cart {
  id     String  @id @default(cuid())
  /// Opaque value stored in the cart cookie.
  token  String  @unique
  userId String?

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  /// Stable digest of the personalisation values. Two lines of the same variant
  /// with different monograms must stay separate, while adding the identical
  /// thing twice should still just bump the quantity — so the digest is part of
  /// the key. Empty string when there is no personalisation.
  personalisationKey String @default("")

  personalisation CartItemPersonalisation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId, personalisationKey])
  @@index([variantId])
}

/// Roles are on the user from the start so the Phase 7 admin is a check, not a
/// migration.
enum Role {
  CUSTOMER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  /// scrypt, salted per user. Never the raw password, obviously.
  passwordHash    String
  emailVerifiedAt DateTime?

  role Role @default(CUSTOMER)

  /// Lockout survives restarts because it lives here rather than in memory.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  sessions  Session[]
  tokens    VerificationToken[]
  addresses Address[]
  carts     Cart[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Server-side sessions. The cookie holds only an opaque token, so signing
/// someone out is a delete here rather than hoping a JWT expires.
model Session {
  id     String @id @default(cuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Email verification and password reset. Only a hash of the token is stored,
/// so a leaked database still cannot be used to reset anyone's password.
model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the customer calls it — "Home", "Mum's".
  label      String?
  name       String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String
  country    String  @default("CA")
  phone      String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Fixed-window counters for rate limiting.
///
/// Kept in the database rather than memory so a restart cannot clear an
/// attacker's budget, and so it still holds if this ever runs as more than one
/// process. Rows are disposable — expired ones are swept opportunistically.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

enum OrderStatus {
  /// Payment intent created, money not taken yet.
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

/// An order snapshots everything it needs.
///
/// Nothing here is a live reference to the catalogue, because an order is a
/// record of what someone actually bought at a moment in time. Renaming a
/// product, changing its price, or deleting a variant must never rewrite
/// history — least of all a personalisation the customer paid to have made.
model Order {
  id     String @id @default(cuid())
  /// Human-facing, e.g. MB-2026-0007. Shown to customers; never the raw id.
  number String @unique

  /// Null for guest checkout — an order does not require an account.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Always captured, account or not. This is where the receipt goes.
  email  String

  status OrderStatus @default(PENDING)

  subtotalCents Int
  shippingCents Int    @default(0)
  taxCents      Int    @default(0)
  totalCents    Int
  currency      String @default("cad")

  /// Address snapshot rather than a relation: saved addresses get edited and
  /// deleted, and a shipped order must still say where it went.
  shipName       String
  shipLine1      String
  shipLine2      String?
  shipCity       String
  shipRegion     String?
  shipPostalCode String
  shipCountry    String  @default("CA")
  shipPhone      String?

  shippingMethod String?

  stripePaymentIntentId String?   @unique
  paidAt                DateTime?
  fulfilledAt           DateTime?
  trackingNumber        String?
  /// Anything the maker needs to remember about this one.
  notes                 String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Kept for reporting, but nullable and SetNull: deleting a product must not
  /// delete the record of someone having bought it.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// Snapshots.
  productName  String
  productSlug  String
  variantLabel String  @default("")
  sku          String?

  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  personalisation OrderItemPersonalisation[]

  @@index([orderId])
  @@index([variantId])
}

/// The personalisation as it was ordered. Label is copied too, so renaming the
/// field later cannot change what an old order says the customer asked for.
model OrderItemPersonalisation {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  label String
  value String

  @@index([orderItemId])
}
