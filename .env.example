# Copy to `.env.local` and fill in. `.env*` is gitignored; this template is not.

# Public base URL — used for canonical links, OG tags, the sitemap and every
# link inside a transactional email.
#
# Set this to the address customers actually use. Left at localhost while
# serving publicly, every page advertises a canonical URL that search engines
# cannot reach, and password-reset links point at the visitor's own machine.
#
# NEXT_PUBLIC_* is inlined at build time, so it must be set before `next build`.
NEXT_PUBLIC_SITE_URL="https://mabrowns.ca"

# --- Pre-launch gate ---
# While true, everyone except allowed clients sees the coming-soon page.
# Set to "false" at launch.
# Public hostname(s) the dev server is reached on, comma separated. Required
# in dev for anything beyond localhost/LAN, or the HMR socket is blocked
# cross-origin and the page never hydrates.
SITE_DEV_ORIGINS="example.com,www.example.com"

SITE_LOCKED=true
# Visit any URL with ?preview=<token> once to unlock a device (works from a
# phone on cellular, and through Cloudflare, where IP allowlisting can't).
SITE_PREVIEW_TOKEN=""
# Optional comma-separated CIDRs; overrides the built-in defaults of
# loopback + LAN + tailnet.
# SITE_ALLOWED_IPS="127.0.0.1/32,10.0.0.0/8,100.64.0.0/10"

# --- Phase 1: database ---
# Absolute path is deliberate: keep it off any NTFS/exFAT/network mount, where
# SQLite WAL fails with "disk I/O error".
# DATABASE_URL="file:/absolute/path/to/dev.db"

# --- Phase 3: auth ---
# AUTH_SECRET=""

# --- Payments ---
# Test keys (sk_test_/pk_test_) work without activating the Stripe account.
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From the webhook endpoint's signing secret. Without it the webhook refuses
# every request, which means orders never get marked paid.
# STRIPE_WEBHOOK_SECRET=""

# --- Transactional email ---
# Without RESEND_API_KEY, messages print to the server console with their links
# so the flows stay testable. Never silently dropped.
# RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
# EMAIL_FROM="MaBrown's Creations <noreply@mabrowns.ca>"
