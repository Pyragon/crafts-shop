# Reverse proxy in front of Next.js.
#
# Terminates TLS with Cloudflare Origin CA certificates so the hop from
# Cloudflare to this machine is encrypted — the requirement for SSL/TLS mode
# "Full (strict)". Those certs are trusted by Cloudflare only, not by browsers,
# which is fine: browsers never talk to this box directly.
#
# Addresses are written with explicit schemes so there's no ambiguity about
# which block owns which port while auto_https is off.
#
#   caddy run --config deploy/Caddyfile
{
	# Admin API on loopback only, so `caddy reload` works (zero-downtime).
	admin localhost:2019
	# No ACME: certs come from Cloudflare's Origin CA, and this box isn't
	# publicly resolvable for an HTTP-01 challenge anyway.
	auto_https off
}

(app) {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000 {
		# Keep the original Host so Next sees the real domain, and preserve the
		# websocket upgrade used by dev HMR.
		header_up Host {host}
		header_up X-Forwarded-Host {host}

		# Next derives its request URLs from X-Forwarded-Proto. With https there,
		# an internal rewrite looks cross-origin to it (the origin server itself
		# speaks plain HTTP on loopback), so it tries to proxy to
		# https://localhost:3000 and fails with "wrong version number".
		# Strip it and pass the real scheme under a name Next doesn't interpret.
		header_up -X-Forwarded-Proto
		header_up X-Origin-Proto {scheme}
	}
}

# --- mabrowns.ca — the canonical domain, serves the shop -------------------
https://mabrowns.ca, https://www.mabrowns.ca {
	tls /home/cody/.config/mabrowns-tls/mabrowns-ca.pem /home/cody/.config/mabrowns-tls/mabrowns-ca.key
	import app
}

http://mabrowns.ca, http://www.mabrowns.ca {
	import app
}

# --- mabrown.ca — typo domain, 301s to the canonical one -------------------
#
# Redirecting rather than serving is deliberate. Two domains serving identical
# content is duplicate content: search engines pick a winner arbitrarily and
# split ranking signals and backlinks between them. A 301 consolidates all of
# that onto mabrowns.ca. {uri} preserves the path, so a deep link still lands
# in the right place.
https://mabrown.ca, https://www.mabrown.ca {
	tls /home/cody/.config/mabrowns-tls/mabrown-ca.pem /home/cody/.config/mabrowns-tls/mabrown-ca.key
	redir https://mabrowns.ca{uri} permanent
}

http://mabrown.ca, http://www.mabrown.ca {
	redir https://mabrowns.ca{uri} permanent
}

# --- direct IP access (LAN, Tailscale) ------------------------------------
# Catch-all for port 80; the host-specific blocks above take precedence.
:80 {
	import app
}
